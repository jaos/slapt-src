#, c-format
msgid "%s version %s\n"
msgstr "%s версия %s\n"

#, c-format
msgid "%s - A SlackBuild utility\n"
msgstr "%s - SlackBuild средство\n"

#, c-format
msgid "Usage: %s [option(s)] [action] [slackbuild(s)]\n"
msgstr "Употреба: %s [опция(и)] [действие] [slackbuild(-ове)]\n"

msgid "update local cache of remote slackbuilds"
msgstr "обнови локалната кеш памет на отделни slackbuild-ове"

msgid "upgrade all installed slackbuilds"
msgstr "обнови всички инсталирани slackbuild-ове"

msgid "list available slackbuilds"
msgstr "покажи наличните slackbuild-ове"

msgid "clean build directory"
msgstr "изчисти директорията за изграждане"

msgid "search available slackbuilds"
msgstr "търси наличните slackbuild-ове"

msgid "show specified slackbuilds"
msgstr "покажи посочените slackbuild-ове"

msgid "fetch, build, and install the specified slackbuild(s)"
msgstr "извлечи, изгради и инсталирай посочения slackbuild(-ове)"

msgid "only fetch and build the specified slackbuild(s)"
msgstr "само извлечи и изгради посочените slackbuild(-ове)"

msgid "only fetch the specified slackbuild(s)"
msgstr "само извлечи посочените slackbuild(-ове)"

msgid "Options"
msgstr "Опции"

msgid "do not prompt"
msgstr "не питай"

msgid "show what will be done"
msgstr "покажи какво ще се направи"

msgid "use the specified configuration file"
msgstr "използвай посоченият конфигурационен файл"

msgid "do not look for dependencies"
msgstr "не търси зависимости"

msgid "run specified command on generated package"
msgstr "изпълни посочената команда на вече генериран пакет"

msgid "applicable only to --upgrade-all"
msgstr "приложимо само при --upgrade-all"

msgid "skip if available via slapt-get, applicable only to --upgrade-all"
msgstr ""

#, c-format
msgid "Failed to create build directory [%s]\n"
msgstr "Неуспех при създаване на директория за изграждане [%s]\n"

#, c-format
msgid "Specify only one action\n"
msgstr ""

#, c-format
msgid "Individual packages not accepted when upgrading all slackbuilds\n"
msgstr ""
"Индивидуални пакети, които не са приети при обновяването на всички "
"slackbuild-ове\n"

#, c-format
msgid "build-only and fetch-only options are mutually exclusive\n"
msgstr "build-only и fetch-only се изключват взаимно\n"

msgid "Failed to chdir to build directory"
msgstr "Неуспех на chdir в директорията за изграждане"

#, c-format
msgid "Unable to find all specified slackbuilds.\n"
msgstr "Неуспех при търсенето на посочените slackbuild-ове.\n"

#, c-format
msgid "FETCH: %s\n"
msgstr "ИЗВЛИЧАНЕ: %s\n"

#, c-format
msgid "BUILD: %s\n"
msgstr "ИЗГРАДИ: %s\n"

#, c-format
msgid "INSTALL: %s\n"
msgstr "ИНСТАЛИРАЙ: %s\n"

#, c-format
msgid "SlackBuild Name: %s\n"
msgstr "SlackBuild Име: %s\n"

#, c-format
msgid "SlackBuild Version: %s\n"
msgstr "SlackBuild Версия: %s\n"

#, c-format
msgid "SlackBuild Category: %s\n"
msgstr "SlackBuild Категория: %s\n"

#, c-format
msgid "SlackBuild Description: %s\n"
msgstr "SlackBuild Описание: %s\n"

#, c-format
msgid "SlackBuild Files:\n"
msgstr "SlackBuild Файлове:\n"

#, c-format
msgid "SlackBuild Requires: %s\n"
msgstr "SlackBuild Изисква: %s\n"

#, c-format
msgid "Done\n"
msgstr "Готово\n"

#, c-format
msgid "The following packages will be %s:\n"
msgstr "Следните пакети ще бъдат %s:\n"

msgid "installed"
msgstr "инсталиран"

msgid "built"
msgstr "изгради"

msgid "fetched"
msgstr "извлечен"

#, c-format
msgid "The following dependent slackbuilds will be built and installed:\n"
msgstr "Следните зависими slackbuild-ове ще бъдат изградени и инсталирани:\n"

msgid "Do you want to continue? [y/N] "
msgstr "Желаете ли да продължите? [y(да)/N(НЕ)] "

#, c-format
msgid "Abort.\n"
msgstr "Прекъсване.\n"

#, c-format
msgid "Failed to read %s\n"
msgstr "Неуспех при четене %s\n"

#, c-format
msgid "No BUILDDIR specified in the configuration\n"
msgstr "BUILDDIR не е зададен в конфигурацията\n"

#, c-format
msgid "BUILDDIR too long\n"
msgstr ""

#, c-format
msgid "Fetching slackbuild list from %s..."
msgstr "Извличане на slackbuild лист от %s..."

#, c-format
msgid "Cached\n"
msgstr "Кеширан\n"

#, c-format
msgid "Download failed: %s\n"
msgstr "Изтеглянето се провали: %s\n"

#, c-format
msgid "Refusing to overwrite cache with incomplete list\n"
msgstr ""

#, fuzzy, c-format
msgid "Failed to open %s for writing\n"
msgstr "Неуспех при отваряне на %s за четене\n"

#, fuzzy, c-format
msgid "Failed to read %s: empty or corrupt gzip\n"
msgstr "Неуспех при четене %s\n"

#, c-format
msgid "Run --update to fetch the slackbuild list first\n"
msgstr ""

#, c-format
msgid "Failed to open %s for reading\n"
msgstr "Неуспех при отваряне на %s за четене\n"

#, c-format
msgid "Failed to chdir to %s\n"
msgstr "Неуспех на chdir в %s\n"

#, c-format
msgid "Fetching %s..."
msgstr "Извличане %s..."

#, c-format
msgid "Failed\n"
msgstr "Неуспех\n"

#, c-format
msgid "Mismatch between download files and md5sums\n"
msgstr "Несъответствие между изтеглените файлове и md5sum-ите\n"

#, c-format
msgid "Invalid download URL: %s\n"
msgstr ""

#, c-format
msgid "MD5SUM mismatch for %s\n"
msgstr "MD5SUM несъответствие за %s\n"

#, fuzzy, c-format
msgid "Failed to open the README for %s\n"
msgstr "Неуспех при отваряне на %s за четене\n"

#, c-format
msgid "Failed to open current directory\n"
msgstr "Неуспех при отваряне на сегашната директория\n"

#, fuzzy, c-format
msgid "Failed to construct script name\n"
msgstr "Неуспех при конструирането на команден низ\n"

#, c-format
msgid "Unable to find generated package\n"
msgstr "Неуспех при търсенето на генерирания пакет\n"

#, fuzzy, c-format
msgid "Circular dependency: %s requires %s\n"
msgstr "Липсва slackbuild: %s изисква %s\n"

#, c-format
msgid "Missing slackbuild: %s requires %s\n"
msgstr "Липсва slackbuild: %s изисква %s\n"

#, fuzzy, c-format
msgid "Unknown slackbuild: %s\n"
msgstr "SlackBuild Име: %s\n"
