#, c-format
msgid "%s version %s\n"
msgstr "%s verze %s\n"

#, c-format
msgid "%s - A SlackBuild utility\n"
msgstr "%s - Nástroj pro SlackBuild\n"

#, c-format
msgid "Usage: %s [option(s)] [action] [slackbuild(s)]\n"
msgstr "Použití: %s [volby] [akce] [slackbuild(y)]\n"

msgid "update local cache of remote slackbuilds"
msgstr "aktualizovat místní mezipaměť vzdálených seznamů SlackBuildů"

msgid "upgrade all installed slackbuilds"
msgstr "upgradovat všechny nainstalované SlackBuildy"

msgid "list available slackbuilds"
msgstr "seznam dostupných SlackBuildů"

msgid "clean build directory"
msgstr "vyprázdnit sestavovací adresář"

msgid "search available slackbuilds"
msgstr "vyhledat dostupné SlackBuildy"

msgid "show specified slackbuilds"
msgstr "zobrazit uvedené SlackBuildy"

msgid "fetch, build, and install the specified slackbuild(s)"
msgstr "stáhnout, sestavit a nainstalovat zadané SlackBuildy"

msgid "only fetch and build the specified slackbuild(s)"
msgstr "pouze stáhnout a sestavit zadané SlackBuildy"

msgid "only fetch the specified slackbuild(s)"
msgstr "pouze stáhnout zadané SlackBuildy"

msgid "Options"
msgstr "Přepínače"

msgid "do not prompt"
msgstr "neptat se"

msgid "show what will be done"
msgstr "zobrazit akce, které se provedou"

msgid "use the specified configuration file"
msgstr "použít určený konfigurační soubor"

msgid "do not look for dependencies"
msgstr "nehledat závislosti"

msgid "run specified command on generated package"
msgstr "spustit na vygenerovaném balíčku zadaný příkaz"

msgid "applicable only to --upgrade-all"
msgstr "použitelné pouze pro volbu --upgrade-all"

msgid "skip if available via slapt-get, applicable only to --upgrade-all"
msgstr ""
"přeskočit, pokud je dostupné přes slapt-get; použitelné pouze pro --upgrade-"
"all"

#, c-format
msgid "Failed to create build directory [%s]\n"
msgstr "Nepodařilo se vytvořit sestavovací adresář [%s]\n"

#, c-format
msgid "Specify only one action\n"
msgstr "Zadejte pouze jednu akci\n"

#, c-format
msgid "Individual packages not accepted when upgrading all slackbuilds\n"
msgstr "Při upgradování všech SlackBuildů nelze zadávat jednotlivé balíčky\n"

#, c-format
msgid "build-only and fetch-only options are mutually exclusive\n"
msgstr "přepínače build-only a fetch-only se vzájemně vylučují\n"

msgid "Failed to chdir to build directory"
msgstr "Nepodařilo se změnit adresář na sestavovací adresář"

#, c-format
msgid "Unable to find all specified slackbuilds.\n"
msgstr "Nelze najít všechny zadané SlackBuildy.\n"

#, c-format
msgid "FETCH: %s\n"
msgstr "STAŽENÍ: %s\n"

#, c-format
msgid "BUILD: %s\n"
msgstr "SESTAVENÍ: %s\n"

#, c-format
msgid "INSTALL: %s\n"
msgstr "INSTALACE: %s\n"

#, c-format
msgid "SlackBuild Name: %s\n"
msgstr "Název SlackBuild: %s\n"

#, c-format
msgid "SlackBuild Version: %s\n"
msgstr "Verze SlackBuild: %s\n"

#, c-format
msgid "SlackBuild Category: %s\n"
msgstr "Kategorie SlackBuild: %s\n"

#, c-format
msgid "SlackBuild Description: %s\n"
msgstr "Popis SlackBuild: %s\n"

#, c-format
msgid "SlackBuild Files:\n"
msgstr "Soubory SlackBuild:\n"

#, c-format
msgid "SlackBuild Requires: %s\n"
msgstr "SlackBuild vyžaduje: %s\n"

#, c-format
msgid "Done\n"
msgstr "Hotovo\n"

#, c-format
msgid "The following packages will be %s:\n"
msgstr "Tyto balíčky budou %s:\n"

msgid "installed"
msgstr "instalováno"

msgid "built"
msgstr "sestaveno"

msgid "fetched"
msgstr "staženo"

#, c-format
msgid "The following dependent slackbuilds will be built and installed:\n"
msgstr "Budou sestaveny a nainstalovány tyto závislé slackbuildy:\n"

msgid "Do you want to continue? [y/N] "
msgstr "Chcete pokračovat? [y/N] "

#, c-format
msgid "Abort.\n"
msgstr "Zrušit.\n"

#, c-format
msgid "Failed to read %s\n"
msgstr "Nepodařilo se přečíst %s\n"

#, c-format
msgid "No BUILDDIR specified in the configuration\n"
msgstr "V konfiguraci není specifikován adresář BUILDDIR\n"

#, c-format
msgid "BUILDDIR too long\n"
msgstr "BUILDDIR je příliš dlouhý\n"

#, c-format
msgid "Fetching slackbuild list from %s..."
msgstr "Stahování seznamu SlackBuildů z %s..."

#, c-format
msgid "Cached\n"
msgstr "V mezipaměti\n"

#, c-format
msgid "Download failed: %s\n"
msgstr "Stažení se nezdařilo: %s\n"

#, c-format
msgid "Refusing to overwrite cache with incomplete list\n"
msgstr "Odmítá se přepsání mezipaměti neúplným seznamem\n"

#, c-format
msgid "Failed to open %s for writing\n"
msgstr "Nepodařilo se otevřít %s pro zápis\n"

#, c-format
msgid "Failed to read %s: empty or corrupt gzip\n"
msgstr "Nepodařilo se přečíst %s: prázdný nebo poškozený soubor gzip\n"

#, c-format
msgid "Run --update to fetch the slackbuild list first\n"
msgstr "Nejprve spusťte --update a stáhněte seznam SlackBuildů\n"

#, c-format
msgid "Failed to open %s for reading\n"
msgstr "Nepodařilo se otevřít %s pro čtení\n"

#, c-format
msgid "Failed to chdir to %s\n"
msgstr "Nepodařilo se změnit adresář na: %s\n"

#, c-format
msgid "Fetching %s..."
msgstr "Stahování %s..."

#, c-format
msgid "Failed\n"
msgstr "Nepodařilo se\n"

#, c-format
msgid "Mismatch between download files and md5sums\n"
msgstr "Stažené soubory neodpovídají součtům MD5\n"

#, c-format
msgid "Invalid download URL: %s\n"
msgstr "Neplatná adresa URL pro stažení: %s\n"

#, c-format
msgid "MD5SUM mismatch for %s\n"
msgstr "MD5SUM pro %s se neshoduje\n"

#, c-format
msgid "Failed to open the README for %s\n"
msgstr "Nepodařilo se otevřít soubor README pro %s\n"

#, c-format
msgid "Failed to open current directory\n"
msgstr "Nepodařilo se otevřít aktuální adresář\n"

#, c-format
msgid "Failed to construct script name\n"
msgstr "Nepodařilo se sestavit název skriptu\n"

#, c-format
msgid "Unable to find generated package\n"
msgstr "Nelze najít vygenerovaný balíček\n"

#, c-format
msgid "Circular dependency: %s requires %s\n"
msgstr "Cyklická závislost: %s vyžaduje %s\n"

#, c-format
msgid "Missing slackbuild: %s requires %s\n"
msgstr "Chybějící SlackBuild: %s vyžaduje %s\n"

#, c-format
msgid "Unknown slackbuild: %s\n"
msgstr "Neznámý SlackBuild: %s\n"
